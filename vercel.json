{
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/kyrbirt run build",
  "outputDirectory": "artifacts/kyrbirt/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{lib/api-zod/package.json,lib/api-zod/src/**,lib/db/package.json,lib/db/src/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/drops",
      "destination": "/index.html"
    },
    {
      "source": "/mantenimiento",
      "destination": "/index.html"
    },
    {
      "source": "/umantenimiento",
      "destination": "/index.html"
    }
  ]
}